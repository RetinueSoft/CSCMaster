<div class="modal fade" id="CustomerSelector" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content" ng-controller="CustomerSelectorController">
            <div class="modal-header">
                <h5 class="modal-title">{{title}} Selector</h5>

                <button type="button" class="close" ng-click="modalClose()" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">

                    <txtgrp id="customer" label="Customer" cdivcls="col-md-12" placeholder="Customer" sclick="listCustomers()"
                            maxlength="200" model="input.searchBy" required></txtgrp>

                    <txtgrp id="caddress" cdivcls="col-md-12" placeholder="City/Address" inline="true" ng-show="manage"
                            maxlength="200" model="input.address" required></txtgrp>

                    <cmbgrp id="mobileType" model="mobileType" cdivcls="col-md-6" list="mobileNumberTypes" ng-show="manage"
                            display="['displayName']" inline="true" mt="mt-4"></cmbgrp>

                    <mobilegrp id="cmobile" placeholder="9999999999" cdivcls="col-md-6" inline="true" ng-show="manage" fa="fa-solid fa-plus"
                               sclick="addPhone(mobileType, phoneNumber)" model="phoneNumber" required></mobilegrp>

                    <div class="col-12" ng-show="manage">
                        <span ng-repeat="item in input.contactNumber"><a href ng-click="removePhone(item)">X</a> {{item.type.displayName}} - {{item.number}}, </span>
                    </div>


                    <scbtngrp id="save" label="Save" cdivcls="col-md-12" mt="mt-5" ng-show="manage"
                              sclick="saveCustomer(input)" cclick="cancelManage()"></scbtngrp>

                    <a href ng-click="manage=true" class="col-md-12 text-right" ng-hide="manage">+Add</a>

                    <div class="col-sm-12" ng-hide="manage">
                        <table class="table topborderless">
                            <tbody>
                                <tr ng-repeat="customer in customers">
                                    <td width="70%">{{customer.name}}: {{customer.displayContactNumber}}</td>
                                    <td align="right">
                                        <div class="d-flex gap-1 justify-content-end">
                                            <editbtngrp click="editCustomerClicked(customer);"></editbtngrp>
                                            <iconbtngrp click="selectCustomer(customer)" tooltip="Select">
                                                <i class="fa-solid fa-check"></i>
                                            </iconbtngrp>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
