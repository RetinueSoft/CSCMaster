# Settings for the server. update.sh creates .env from this file on the first run
# and later adds any new settings from here to .env (your values are never overwritten).
# .env is not committed: it holds passwords. The GitHub token is read from /root/.github_token.

# Public addresses (served by the server's main Caddy). The browser loads the UI and calls the API directly.
UI_PUBLIC_URL=https://cscmaster.online
API_PUBLIC_URL=https://api.cscmaster.online
# Ports on the server that the main Caddy proxies to.
UI_HOST_PORT=8085
API_HOST_PORT=8084

# PostgreSQL password for user "postgres". Avoid ; and ' characters (used in connection strings).
POSTGRES_PASSWORD=
POSTGRES_DB=cscmaster
# Port on the server itself (127.0.0.1 only) for SSH-tunnel access with pgAdmin/DBeaver.
POSTGRES_HOST_PORT=5435

# JWT signing key (at least 32 characters). update.sh fills in a random one on the first run.
# Changing it logs everyone out.
JWT_KEY=

# Time zone the business works in. Business dates use it, wherever the server is.
# System timestamps (enrolment upload time) are stored in UTC.
BUSINESS_TIME_ZONE=Asia/Kolkata
# Server time zone: only affects log timestamps. Can stay UTC.
TZ=UTC

# App image version from ghcr.io: "latest" or a build tag like sha-1a2b3c4 (set by update.sh).
APP_IMAGE_TAG=latest

# Azure Blob backup (backup-db.sh). Blob SAS URL (starts with https://); "Create" + "Write" permissions are enough.
# Paste it as-is inside single quotes (in .bat files '%' was doubled as '%%'; here use a single '%').
AZURE_BACKUP_SAS_URL=''
# Keep the local backup file after a successful upload (true/false).
BACKUP_KEEP_LOCAL=false
