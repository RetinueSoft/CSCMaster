# Settings for the server. update.sh creates /root/common/env/cscmaster.env from this file on the first run
# and later adds any new settings from here (your values are never overwritten). It holds passwords: never commit it.
# Shared settings (GitHub token, Azure backup URL) are in /root/common, see RetinueSoft/VpsSetup.

# Public addresses (served by the server's common Caddy, VpsSetup caddy/sites/cscmaster.caddy). The browser loads the UI and calls the API directly.
UI_PUBLIC_URL=https://cscmaster.online
API_PUBLIC_URL=https://api.cscmaster.online
# Other addresses users open the UI from (the API accepts browser calls only from UI_PUBLIC_URL and these).
# Comma-separated, scheme and port included, no trailing slash. Example: https://50.6.44.173:8085,https://www.cscmaster.online
CORS_ORIGINS=
# Ports on the server (127.0.0.1 only) that the common Caddy proxies to: keep them equal to cscmaster.caddy.
UI_HOST_PORT=8085
API_HOST_PORT=8084

# PostgreSQL password for user "postgres". Avoid ; and ' characters (used in connection strings).
POSTGRES_PASSWORD=
POSTGRES_DB=cscmaster
# Port on the server itself (127.0.0.1 only) for SSH-tunnel access with pgAdmin/DBeaver.
POSTGRES_HOST_PORT=5435

# JWT signing key (at least 32 characters). update.sh fills in a random one on the first run.
# Changing it logs everyone out.
JWT_KEY=

# Time zone the business works in. Business dates use it, wherever the server is.
# System timestamps (enrolment upload time) are stored in UTC.
BUSINESS_TIME_ZONE=Asia/Kolkata
# Server time zone: only affects log timestamps. Can stay UTC.
TZ=UTC

# App image version from ghcr.io: "latest" or a build tag like sha-1a2b3c4 (set by update.sh).
APP_IMAGE_TAG=latest
